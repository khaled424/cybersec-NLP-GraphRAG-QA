# Optional settings (copy to .env or export in your shell). Nothing is required for the default local run.

# Frontend -> API URL
CYBERSEC_API_URL=http://localhost:8000

# Repository root override (containers / non-editable installs)
# CYBERSEC_ROOT=/app

# Optional Neo4j import from Notebook 1 (read-write account for the import only;
# the assistant itself only reads the graph)
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=change-me
# NEO4J_DATABASE=neo4j
